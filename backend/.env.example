# Copy to .env and fill in what you have. Every provider is optional; ones without
# credentials are skipped. You need at least ONE of: GROQ_API_KEY, OLLAMA_BASE_URL.

# --- Free open-weight model providers (default chain) ---
GROQ_API_KEY=            # https://console.groq.com/keys (free tier)
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai (free tier), overflow
OPENROUTER_API_KEY=      # https://openrouter.ai (":free" models), optional
OLLAMA_BASE_URL=         # e.g. http://localhost:11434 for local dev on your GPU

# Override the per-role fallback chains ("provider:model", comma-separated):
# ROUTER_MODELS=groq:openai/gpt-oss-20b,cerebras:gpt-oss-120b,ollama:gpt-oss:20b
# SQL_MODELS=groq:openai/gpt-oss-120b,cerebras:gpt-oss-120b,ollama:gpt-oss:20b

# --- Claude (optional) ---
# Visitors can always bring their own key from the UI. Your own key is used ONLY if
# OWNER_ANTHROPIC_ENABLED=true; set a hard spend limit in the Anthropic Console first.
ANTHROPIC_API_KEY=
OWNER_ANTHROPIC_ENABLED=false

# --- Warehouse ---
# Default: backend/data/tpcds_sf1.duckdb (run `uv run sqlagent generate-data --sf 1`).
# WAREHOUSE_URL=md:tpcds
# MOTHERDUCK_TOKEN=      # use a read-scaling (read-only) token

# --- Conversation state (LangGraph checkpoints); empty = in-memory ---
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
