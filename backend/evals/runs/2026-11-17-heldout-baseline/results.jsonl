{"id": "x11", "category": "medium", "question": "What was the average net profit per web order in 2002?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["web_sales", "date_dim", "catalog_sales", "store_sales"], "sql": "SELECT\n  ROUND(SUM(ws.ws_net_profit) / COUNT(DISTINCT ws.ws_order_number), 2) AS avg_net_profit_per_order\nFROM web_sales AS ws\nJOIN date_dim AS d\n  ON ws.ws_sold_date_sk = d.d_date_sk\nWHERE\n  d.d_year = 2002\nLIMIT 501", "attempts": 1, "executed": true, "match": true, "strict": true, "reason": "match", "error": null, "infra_error": false, "latency_s": 2.9, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1593, "output_tokens": 738, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 3630, "output_tokens": 419, "fallbacks": []}], "notices": []}
{"id": "x12", "category": "medium", "question": "What percentage of in-store revenue in 2002 came from preferred customers?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [{"question": "How do you define 'preferred customers'? For example, customers with credit_rating = 'Preferred', customers with high buying potential, or another criterion?", "answer": "Use sensible defaults and state your assumptions."}], "tables": ["store_sales", "customer", "customer_demographics", "date_dim"], "sql": "WITH sales_2002 AS (\n  SELECT\n    ss.ss_net_paid,\n    cd.cd_credit_rating\n  FROM store_sales AS ss\n  JOIN date_dim AS d\n    ON ss.ss_sold_date_sk = d.d_date_sk\n  JOIN customer_demographics AS cd\n    ON ss.ss_cdemo_sk = cd.cd_demo_sk\n  WHERE\n    d.d_year = 2002\n)\nSELECT\n  ROUND(\n    100.0 * SUM(CASE WHEN cd_credit_rating = 'Preferred' THEN ss_net_paid ELSE 0 END) / NULLIF(SUM(ss_net_paid), 0),\n    2\n  ) AS preferred_revenue_pct\nFROM sales_2002\nLIMIT 501", "attempts": 1, "executed": true, "match": false, "strict": false, "reason": "no predicted column matches gold column 'pct'", "error": null, "infra_error": false, "latency_s": 4.81, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1594, "output_tokens": 730, "fallbacks": []}, {"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1637, "output_tokens": 561, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 3003, "output_tokens": 840, "fallbacks": []}], "notices": []}
{"id": "x13", "category": "medium", "question": "Which product class within the Shoes category had the highest in-store revenue in 2001?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["store_sales", "date_dim", "item"], "sql": "WITH sales_2001 AS (\n  SELECT\n    ss.ss_net_paid,\n    i.i_class\n  FROM store_sales AS ss\n  JOIN date_dim AS d\n    ON ss.ss_sold_date_sk = d.d_date_sk\n  JOIN item AS i\n    ON ss.ss_item_sk = i.i_item_sk\n  WHERE\n    d.d_year = 2001 AND i.i_category = 'Shoes'\n)\nSELECT\n  i_class AS product_class,\n  ROUND(SUM(ss_net_paid), 2) AS revenue\nFROM sales_2001\nGROUP BY\n  i_class\nORDER BY\n  revenue DESC\nLIMIT 1", "attempts": 1, "executed": true, "match": true, "strict": false, "reason": "match", "error": null, "infra_error": false, "latency_s": 3.79, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1597, "output_tokens": 502, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 2866, "output_tokens": 696, "fallbacks": []}], "notices": []}
{"id": "x14", "category": "medium", "question": "In 2002, how much in-store revenue came from sales with a promotion versus without one?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["store_sales", "promotion", "date_dim", "web_sales"], "sql": "WITH filtered AS (\n  SELECT\n    ss.ss_promo_sk,\n    ss.ss_net_paid\n  FROM store_sales AS ss\n  JOIN date_dim AS d\n    ON ss.ss_sold_date_sk = d.d_date_sk\n  WHERE\n    d.d_year = 2002\n)\nSELECT\n  CASE WHEN ss_promo_sk IS NULL THEN 'no_promotion' ELSE 'promotion' END AS promotion_flag,\n  ROUND(SUM(ss_net_paid), 2) AS revenue\nFROM filtered\nGROUP BY\n  promotion_flag\nORDER BY\n  revenue DESC\nLIMIT 501", "attempts": 1, "executed": true, "match": true, "strict": false, "reason": "match", "error": null, "infra_error": false, "latency_s": 2.82, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1599, "output_tokens": 412, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 3480, "output_tokens": 604, "fallbacks": []}], "notices": []}
{"id": "x15", "category": "hard", "question": "Which 10 customers returned the most units to our stores? Show their customer IDs.", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["store_returns", "customer", "reason", "date_dim"], "sql": "SELECT\n  c.c_customer_id AS customer_id,\n  SUM(sr.sr_return_quantity) AS total_units_returned\nFROM store_returns AS sr\nJOIN customer AS c\n  ON sr.sr_customer_sk = c.c_customer_sk\nGROUP BY\n  c.c_customer_id\nORDER BY\n  total_units_returned DESC\nLIMIT 10", "attempts": 1, "executed": true, "match": true, "strict": true, "reason": "match", "error": null, "infra_error": false, "latency_s": 6.58, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1596, "output_tokens": 301, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 2614, "output_tokens": 474, "fallbacks": ["groq:openai/gpt-oss-120b"]}], "notices": [{"type": "fallback", "role": "sql", "model": "groq:openai/gpt-oss-120b", "reason": "rate limit reached"}, {"type": "waiting", "role": "sql", "seconds": 4}]}
{"id": "x16", "category": "hard", "question": "For each year from 1999 to 2002, what was catalog revenue growth versus the previous year, as a percentage?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["catalog_sales", "date_dim"], "sql": "WITH yearly AS (\n  SELECT\n    d.d_year AS year,\n    SUM(cs.cs_net_paid) AS revenue\n  FROM catalog_sales AS cs\n  JOIN date_dim AS d\n    ON cs.cs_sold_date_sk = d.d_date_sk\n  WHERE\n    d.d_year BETWEEN 1998 AND 2002\n  GROUP BY\n    d.d_year\n)\nSELECT\n  y.year,\n  ROUND(\n    (\n      (\n        y.revenue - LAG(y.revenue) OVER (ORDER BY y.year)\n      ) / NULLIF(LAG(y.revenue) OVER (ORDER BY y.year), 0)\n    ) * 100,\n    2\n  ) AS revenue_yoy_pct\nFROM yearly AS y\nWHERE\n  y.year BETWEEN 1999 AND 2002\nORDER BY\n  y.year\nLIMIT 501", "attempts": 1, "executed": true, "match": false, "strict": false, "reason": "no predicted column matches gold column 'growth_pct'", "error": null, "infra_error": false, "latency_s": 10.17, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1605, "output_tokens": 647, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 2475, "output_tokens": 509, "fallbacks": ["groq:openai/gpt-oss-120b"]}], "notices": [{"type": "fallback", "role": "sql", "model": "groq:openai/gpt-oss-120b", "reason": "rate limit reached"}, {"type": "waiting", "role": "sql", "seconds": 7}]}
{"id": "x17", "category": "hard", "question": "How many customers bought in our stores in 2001 but not in 2002?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["store_sales", "date_dim", "customer", "customer_demographics"], "sql": "WITH purchases_2001 AS (\n  SELECT DISTINCT\n    ss_customer_sk\n  FROM store_sales\n  JOIN date_dim AS d\n    ON ss_sold_date_sk = d.d_date_sk\n  WHERE\n    d.d_year = 2001\n), purchases_2002 AS (\n  SELECT DISTINCT\n    ss_customer_sk\n  FROM store_sales\n  JOIN date_dim AS d\n    ON ss_sold_date_sk = d.d_date_sk\n  WHERE\n    d.d_year = 2002\n)\nSELECT\n  COUNT(*) AS distinct_customers\nFROM purchases_2001 AS p1\nWHERE\n  NOT EXISTS(\n    SELECT\n      1\n    FROM purchases_2002 AS p2\n    WHERE\n      p2.ss_customer_sk = p1.ss_customer_sk\n  )\nLIMIT 501", "attempts": 1, "executed": true, "match": false, "strict": false, "reason": "no predicted column matches gold column 'customers'", "error": null, "infra_error": false, "latency_s": 11.67, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1597, "output_tokens": 888, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 2964, "output_tokens": 626, "fallbacks": ["groq:openai/gpt-oss-120b"]}], "notices": [{"type": "fallback", "role": "sql", "model": "groq:openai/gpt-oss-120b", "reason": "rate limit reached"}, {"type": "waiting", "role": "sql", "seconds": 8}]}
