{"id": "x05", "category": "easy", "question": "What was the total refund amount for store returns in 2001?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["store_returns", "date_dim", "catalog_returns", "web_returns"], "sql": "SELECT\n  ROUND(SUM(sr_return_amt_inc_tax), 2) AS total_refund_amount\nFROM store_returns AS sr\nJOIN date_dim AS d\n  ON sr.sr_returned_date_sk = d.d_date_sk\nWHERE\n  d.d_year = 2001\nLIMIT 501", "attempts": 1, "executed": true, "match": false, "strict": false, "reason": "no predicted column matches gold column 'refunds'", "error": null, "infra_error": false, "latency_s": 3.58, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1593, "output_tokens": 552, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 3174, "output_tokens": 441, "fallbacks": []}], "notices": []}
{"id": "x07", "category": "medium", "question": "Which 5 states generated the most in-store revenue in 2002, based on the customer's address at the time of purchase?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["store_sales", "customer", "customer_address", "date_dim"], "sql": "WITH sales_2002 AS (\n  SELECT\n    ss_customer_sk,\n    ss_net_paid\n  FROM store_sales\n  JOIN date_dim\n    ON store_sales.ss_sold_date_sk = date_dim.d_date_sk\n  WHERE\n    date_dim.d_year = 2002\n)\nSELECT\n  ca.ca_state AS state,\n  ROUND(SUM(s.ss_net_paid), 2) AS revenue\nFROM sales_2002 AS s\nJOIN customer AS c\n  ON s.ss_customer_sk = c.c_customer_sk\nJOIN customer_address AS ca\n  ON c.c_current_addr_sk = ca.ca_address_sk\nGROUP BY\n  ca.ca_state\nORDER BY\n  revenue DESC\nLIMIT 5", "attempts": 1, "executed": true, "match": false, "strict": false, "reason": "no predicted column matches gold column 'revenue'", "error": null, "infra_error": false, "latency_s": 4.41, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1605, "output_tokens": 806, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 3190, "output_tokens": 697, "fallbacks": []}], "notices": []}
{"id": "x09", "category": "medium", "question": "How many units of Electronics products were sold through the catalog in 2000?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["catalog_sales", "item", "date_dim", "store_sales"], "sql": "SELECT\n  SUM(cs_quantity) AS units_sold\nFROM catalog_sales AS cs\nJOIN date_dim AS d\n  ON cs.cs_sold_date_sk = d.d_date_sk\nJOIN item AS i\n  ON cs.cs_item_sk = i.i_item_sk\nWHERE\n  d.d_year = 2000 AND i.i_category = 'Electronics'\nLIMIT 501", "attempts": 1, "executed": true, "match": true, "strict": true, "reason": "match", "error": null, "infra_error": false, "latency_s": 2.44, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1595, "output_tokens": 407, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 3612, "output_tokens": 367, "fallbacks": []}], "notices": []}
{"id": "x10", "category": "medium", "question": "How many catalog orders did each call center take overall?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["catalog_sales", "call_center", "date_dim"], "sql": "SELECT\n  cc.cc_name AS call_center_name,\n  COUNT(DISTINCT cs.cs_order_number) AS total_orders\nFROM catalog_sales AS cs\nJOIN call_center AS cc\n  ON cs.cs_call_center_sk = cc.cc_call_center_sk\nGROUP BY\n  cc.cc_name\nORDER BY\n  total_orders DESC\nLIMIT 500", "attempts": 1, "executed": true, "match": true, "strict": true, "reason": "match", "error": null, "infra_error": false, "latency_s": 2.77, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1590, "output_tokens": 486, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 3284, "output_tokens": 502, "fallbacks": []}], "notices": []}
{"id": "x18", "category": "hard", "question": "What was the average number of units per store receipt in 2002?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["store_sales", "date_dim", "store_returns"], "sql": "SELECT\n  ROUND(CAST(SUM(ss_quantity) AS DOUBLE) / COUNT(DISTINCT ss_ticket_number), 2) AS avg_items_per_receipt\nFROM store_sales AS ss\nJOIN date_dim AS d\n  ON ss.ss_sold_date_sk = d.d_date_sk\nWHERE\n  d.d_year = 2002\nLIMIT 501", "attempts": 1, "executed": true, "match": true, "strict": true, "reason": "match", "error": null, "infra_error": false, "latency_s": 2.77, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1594, "output_tokens": 488, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 2582, "output_tokens": 381, "fallbacks": []}], "notices": []}
