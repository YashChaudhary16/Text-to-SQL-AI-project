{"id": "x19", "category": "hard", "question": "What percentage of web units sold in 2002 were shipped by EXPRESS?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["web_sales", "ship_mode", "date_dim"], "sql": "SELECT\n  ROUND(\n    100.0 * SUM(CASE WHEN sm_type = 'EXPRESS' THEN ws_quantity ELSE 0 END) / NULLIF(SUM(ws_quantity), 0),\n    2\n  ) AS express_ship_percentage\nFROM web_sales\nJOIN date_dim\n  ON web_sales.ws_sold_date_sk = date_dim.d_date_sk\nJOIN ship_mode\n  ON web_sales.ws_ship_mode_sk = ship_mode.sm_ship_mode_sk\nWHERE\n  date_dim.d_year = 2002\nLIMIT 501", "attempts": 1, "executed": true, "match": true, "strict": true, "reason": "match", "error": null, "infra_error": false, "latency_s": 2.67, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1594, "output_tokens": 385, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 2907, "output_tokens": 475, "fallbacks": []}], "notices": []}
{"id": "x20", "category": "hard", "question": "Which product category has the highest return rate (units returned divided by units sold) for web sales?", "expected_intent": "data_question", "intent": "data_question", "route_ok": true, "clarifications": [], "tables": ["web_sales", "web_returns", "item", "store_returns", "date_dim"], "sql": "WITH sales AS (\n  SELECT\n    i.i_category AS product_category,\n    SUM(ws.ws_quantity) AS units_sold\n  FROM web_sales AS ws\n  JOIN item AS i\n    ON ws.ws_item_sk = i.i_item_sk\n  GROUP BY\n    i.i_category\n), returns AS (\n  SELECT\n    i.i_category AS product_category,\n    SUM(wr.wr_return_quantity) AS units_returned\n  FROM web_returns AS wr\n  JOIN item AS i\n    ON wr.wr_item_sk = i.i_item_sk\n  GROUP BY\n    i.i_category\n)\nSELECT\n  s.product_category,\n  ROUND(CAST(r.units_returned AS DOUBLE) / NULLIF(s.units_sold, 0), 4) AS return_rate\nFROM sales AS s\nJOIN returns AS r\n  ON s.product_category = r.product_category\nORDER BY\n  return_rate DESC\nLIMIT 1", "attempts": 1, "executed": true, "match": true, "strict": false, "reason": "match", "error": null, "infra_error": false, "latency_s": 8.11, "llm_calls": [{"role": "router", "model": "groq:openai/gpt-oss-20b", "input_tokens": 1599, "output_tokens": 783, "fallbacks": []}, {"role": "sql", "model": "groq:openai/gpt-oss-120b", "input_tokens": 4145, "output_tokens": 890, "fallbacks": ["groq:openai/gpt-oss-120b"]}], "notices": [{"type": "fallback", "role": "sql", "model": "groq:openai/gpt-oss-120b", "reason": "rate limit reached"}, {"type": "waiting", "role": "sql", "seconds": 4}]}
